# ParcelPilot environment template — copy to .env and fill values.
# Spec: ARCHITECTURE.md §33. Database: Neon PostgreSQL. Never commit real secrets.

# POOLED endpoint (-pooler host), sslmode=require — app request-time access (user: app_runtime after migration 0001)
DATABASE_URL=
# DIRECT endpoint (unpooled) — migrations/seed scripts only (project owner role)
DIRECT_URL=
APP_RUNTIME_DB_PASSWORD=

SESSION_COOKIE_NAME=pp_session
SESSION_TTL_HOURS=168
SESSION_IDLE_REFRESH_MIN=60
SEED_DEMO_PASSWORD=

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

ALLOW_RESEED=false
LOG_LEVEL=info
